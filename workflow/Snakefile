def validate_samples(samples, sample_file):
    """Refuse a sample sheet whose rows would silently collapse onto one library or one file.

    Must run on the raw sheet, before the assembly_id explode below (which legitimately
    repeats a (sample_id, library_id) pair once per assembly). Every per-library output is
    keyed on that pair, so a duplicated pair means only the first row's reads are ever
    linked by reads__link__run - the other rows' files are silently ignored, and each
    assembly's read list repeats that one library once per row.
    """
    read_columns = ["forward_filename", "reverse_filename"]
    columns = ["sample_id", "library_id"] + read_columns
    problems = []

    dup_pair = samples.duplicated(["sample_id", "library_id"], keep=False)
    if dup_pair.any():
        problems.append(
            "Duplicate (sample_id, library_id) pairs:\n"
            + samples.loc[dup_pair, columns].to_string(index=False)
            + "\n\nlibrary_id must be unique per sequencing lane/library within a sample (e.g."
            " L001, L002, ...), or concatenate the lanes first (workflow/scripts/"
            "concatenateFiles.sh). Don't use the Illumina S-number (e.g. S14): it is shared"
            " by all lanes of a sample. Otherwise only the first row's reads are processed"
            " and the other rows are silently dropped."
        )

    # Across both columns, so a file listed as forward on one row and reverse on another (or
    # as both forward and reverse of one row) is caught too.
    paths = samples[read_columns].apply(lambda col: col.map(os.path.normpath, na_action="ignore"))
    all_paths = pd.concat([paths[col] for col in read_columns]).dropna()
    dup_path = paths.isin(all_paths[all_paths.duplicated()].tolist()).any(axis=1)
    if dup_path.any():
        problems.append(
            "Rows pointing to the same forward/reverse file:\n"
            + samples.loc[dup_path, columns].to_string(index=False)
            + "\n\nEach FASTQ must be listed exactly once, otherwise its reads are counted"
            " once per row."
        )

    if problems:
        raise ValueError(
            f"Invalid sample sheet {sample_file}:\n\n" + "\n\n".join(problems)
        )


validate_samples(samples, config["sample-file"])

# Process sample information
debug("Processing sample metadata...")


def split_assembly_ids(cell):
    """The assemblies listed in one assembly_ids cell of samples.tsv; empty cell: none"""
    return [] if pd.isna(cell) else cell.replace(" ", "").split(",")


# One row per library and assembly it goes into, so a library can appear several times
samples["assembly_id"] = samples["assembly_ids"].map(split_assembly_ids)
samples = samples.explode("assembly_id").sort_values(["assembly_id", "sample_id", "library_id"])

debug("Generating global variables from sample metadata...")

SAMPLE_LIBRARY = samples[["sample_id", "library_id"]].values.tolist()
debug(f"Generated sample-library pairs: {len(SAMPLE_LIBRARY)}")

in_assembly = samples.dropna(subset=["assembly_id"])
ASSEMBLY_LIBRARIES = in_assembly[["assembly_id", "sample_id", "library_id"]].values.tolist()
debug(f"Generated assembly-sample-library triplets: {len(ASSEMBLY_LIBRARIES)}")

ASSEMBLIES = in_assembly["assembly_id"].unique().tolist()
debug(f"Total assemblies: {len(ASSEMBLIES)}")

# Load paths and features
debug("Loading pipeline-specific paths and feature settings...")

def choose_temp(primary, fallback1=None, fallback2=None):
    """Choose a temporary storage path with fallbacks based on non-empty strings."""
    for path in [primary, fallback1, fallback2]:
        if path != "":  # check if string is not empty
            return path
    raise RuntimeError("No temporary storage available!")


# Fallback chain: shm -> nvme -> tmp
KRAKEN2SHM = choose_temp(config["shm_storage"], config["nvme_storage"], config["tmp_storage"])
KRAKEN2NVME = config["nvme_storage"]
DIAMONDSHM = choose_temp(config["shm_storage"], config["nvme_storage"], config["tmp_storage"])
DIAMONDNVME = config["nvme_storage"]
EGGNOGSHM = choose_temp(config["shm_storage"], config["nvme_storage"], config["tmp_storage"])
